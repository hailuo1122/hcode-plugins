{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HCode Community Plugin Entry",
  "description": "plugins/<name>.json 投稿条目的格式定义（编辑器提示用；CI 实际校验以 scripts/validate-entry.mjs 为准）",
  "type": "object",
  "required": ["name", "description", "source"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "description": "插件名，必须与文件名一致，且与插件仓库 .zcode-plugin/plugin.json 的 name 一致"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "一句话说明"
    },
    "source": {
      "description": "安装来源（github 推荐）",
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "repo"],
          "additionalProperties": false,
          "properties": {
            "source": { "const": "github" },
            "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
            "ref": { "type": "string", "description": "分支 / tag，推荐钉 release tag" },
            "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "path": { "type": "string", "description": "插件在仓库内的子目录（monorepo 用）" }
          }
        },
        {
          "type": "object",
          "required": ["source", "url"],
          "additionalProperties": false,
          "properties": {
            "source": { "const": "git" },
            "url": { "type": "string" },
            "ref": { "type": "string" },
            "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "path": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["source", "type", "url", "sha256"],
          "additionalProperties": false,
          "properties": {
            "source": { "const": "url" },
            "type": { "const": "zip" },
            "url": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "path": { "type": "string" },
            "stripRoot": { "type": "boolean" }
          }
        }
      ]
    },
    "author": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "url": { "type": "string" } }
        }
      ]
    },
    "homepage": { "type": "string" },
    "icon": { "type": "string" },
    "category": { "type": "string" },
    "displayName": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "examplePrompts": { "type": "array", "items": { "type": "string" } },
    "privacyPolicy": { "type": "string" },
    "termsOfService": { "type": "string" }
  }
}
